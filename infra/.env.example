# PostgreSQL / TimescaleDB Configuration
POSTGRES_USER=iot_user
POSTGRES_PASSWORD=iot_secure_password
POSTGRES_DB=iot_platform
POSTGRES_PORT=5433

# Mosquitto MQTT Configuration
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Telemetry Retention Configuration
MAX_TELEMETRY_RECORDS=10000
TELEMETRY_PRUNE_INTERVAL_SEC=30

# Redis Cache & Rate Limiting Configuration
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_PASSWORD=

# Firebase Cloud Messaging (FCM) Production Configuration
# Option 1: Drop service-account.json into infra/fcm/ (Recommended for Google Cloud HTTP v1)
# Option 2: Provide inline JSON in FCM_SERVICE_ACCOUNT_JSON
FCM_SERVICE_ACCOUNT_JSON=
FCM_CREDENTIALS_FILE=infra/fcm/service-account.json
# Option 3: Legacy FCM Server Key
FCM_SERVER_KEY=

